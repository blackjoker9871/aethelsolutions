# ==============================================================================
# AETHEL SOLUTIONS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Copy this file to .env.local for local development.
# NEVER commit credentials or API keys to version control.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. DATABASE CONFIGURATION (Optional - falls back to In-Memory repository in dev)
# ------------------------------------------------------------------------------
# PostgreSQL connection string (Supabase, Neon, AWS RDS, etc.)
DATABASE_URL=

# ------------------------------------------------------------------------------
# 2. EMAIL INTEGRATION
# ------------------------------------------------------------------------------
# Provider options: resend | sendgrid | console
EMAIL_PROVIDER=resend
EMAIL_API_KEY=

# Primary internal destination for incoming engineering brief notifications
AETHEL_NOTIFICATION_EMAIL=aethel.officialdesk@gmail.com

# ------------------------------------------------------------------------------
# 3. CRM INTEGRATION (Optional - inactive when unset)
# ------------------------------------------------------------------------------
# Provider options: hubspot | zoho | salesforce | webhook
CRM_PROVIDER=
CRM_API_KEY=
CRM_WEBHOOK_URL=

# ------------------------------------------------------------------------------
# 4. NOTIFICATION & MESSAGING ADAPTERS (Optional - inactive when unset)
# ------------------------------------------------------------------------------
# Provider options: twilio | meta | gupshup
WHATSAPP_PROVIDER=
WHATSAPP_API_KEY=
WHATSAPP_PHONE_NUMBER_ID=

# ------------------------------------------------------------------------------
# 5. PRIVACY-CONSCIOUS ANALYTICS & CONVERSION TRACKING (Optional)
# ------------------------------------------------------------------------------
# Google Analytics 4 Measurement ID (e.g., G-XXXXXXXXXX)
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta Pixel ID (e.g., 123456789012345)
NEXT_PUBLIC_META_PIXEL_ID=

# Google Search Console verification token
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# Enable verbose analytics event logging in browser console (true | false)
NEXT_PUBLIC_ANALYTICS_DEBUG=false

# ------------------------------------------------------------------------------
# 6. SITE METADATA & ORIGIN SECURITY
# ------------------------------------------------------------------------------
NEXT_PUBLIC_SITE_URL=https://aethelsolution.in
NODE_ENV=development
